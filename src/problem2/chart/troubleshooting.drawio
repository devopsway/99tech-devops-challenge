thogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="triage-v41" target="triage-v43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="triage-v45" value="A. NGINX logs&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;/var/log/nginx&lt;/font&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=20;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="201.0" y="1350" width="150" height="60" as="geometry"/></mxCell><mxCell id="triage-e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="triage-v43" target="triage-v45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="triage-v47" value="C. Proxy cache&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;proxy_cache_path&lt;/font&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=20;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="363.0" y="1350" width="150" height="60" as="geometry"/></mxCell><mxCell id="triage-e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="triage-v43" target="triage-v47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="triage-v49" value="E. journald / rsyslog&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;/var/log/journal&lt;/font&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=20;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="525.0" y="1350" width="150" height="60" as="geometry"/></mxCell><mxCell id="triage-e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="triage-v43" target="triage-v49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="triage-v51" value="F. apt, kernels, snaps&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;/var/cache/apt, /boot&lt;/font&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=20;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="687.0" y="1350" width="150" height="60" as="geometry"/></mxCell><mxCell id="triage-e52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="triage-v43" target="triage-v51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="triage-v53" value="G. Dumps, stray files&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;/var/crash, /home, /tmp&lt;/font&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=20;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="849.0" y="1350" width="150" height="60" as="geometry"/></mxCell><mxCell id="triage-e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="triage-v43" target="triage-v53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="triage-v55" value="&lt;b&gt;Read the disk usage graph too&lt;/b&gt;&lt;br&gt;Flat at 99%: something capped (C, E, H, or A at steady retention)&lt;br&gt;Steady climb: A or B&lt;br&gt;Spikes with traffic: D" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;shape=note;size=14;fillColor=#F5F5F5;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="1460" width="420" height="90" as="geometry"/></mxCell><mxCell id="triage-v56" value="&lt;b&gt;Where to run each check&lt;/b&gt;&lt;br&gt;Live host: impact, df / du gap, lsof (B and D only exist in running processes).&lt;br&gt;Snapshot clone: du, find, reading logs and config, so the busy host takes no extra I/O." style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;shape=note;size=14;fillColor=#F5F5F5;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="500" y="1460" width="560" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="handle" name="2. Check, analyse, handle"><mxGraphModel background="#ffffff" dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="handle-v1" value="&lt;b&gt;Per root cause: check, analyse, recover, prevent&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#232F3E;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="handle-v2" value="Root cause" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=0;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="190" height="34" as="geometry"/></mxCell><mxCell id="handle-v3" value="Check (confirm it)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=0;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="60" width="360" height="34" as="geometry"/></mxCell><mxCell id="handle-v4" value="Analyse (why it happened)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=0;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="630" y="60" width="320" height="34" as="geometry"/></mxCell><mxCell id="handle-v5" value="Recover (now)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=0;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="970" y="60" width="360" height="34" as="geometry"/></mxCell><mxCell id="handle-v6" value="Prevent (lasting fix)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=0;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1350" y="60" width="400" height="34" as="geometry"/></mxCell><mxCell id="handle-v7" value="A. NGINX access / error logs" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=20;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="190" height="96" as="geometry"/></mxCell><mxCell id="handle-v8" value="&lt;font face=&quot;Courier New&quot;&gt;/var/log/nginx&lt;/font&gt; tops &lt;font face=&quot;Courier New&quot;&gt;du&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;grep nginx /var/lib/logrotate/status&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;logrotate -d /etc/logrotate.d/nginx&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="360" height="96" as="geometry"/></mxCell><mxCell id="handle-v9" value="rotation not running or broken?&lt;br&gt;error_log left at debug/info?&lt;br&gt;Health checks flooding access log?&lt;br&gt;14-day retention too long for traffic?" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="630" y="110" width="320" height="96" as="geometry"/></mxCell><mxCell id="handle-v10" value="&lt;font face=&quot;Courier New&quot;&gt;truncate -s 0 access.log&lt;/font&gt;&lt;br&gt;delete old &lt;font face=&quot;Courier New&quot;&gt;access.log.*.gz&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;logrotate -f&lt;/font&gt; once config is fixed" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="970" y="110" width="360" height="96" as="geometry"/></mxCell><mxCell id="handle-v11" value="&lt;font face=&quot;Courier New&quot;&gt;maxsize 1G&lt;/font&gt;, shorter &lt;font face=&quot;Courier New&quot;&gt;rotate&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;error_log ... warn&lt;/font&gt;, skip health checks&lt;br&gt;ship logs to CloudWatch Logs" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1350" y="110" width="400" height="96" as="geometry"/></mxCell><mxCell id="handle-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v7" target="handle-v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v8" target="handle-v9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v9" target="handle-v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v10" target="handle-v11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-v16" value="B. Deleted log still held open" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=20;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="224" width="190" height="96" as="geometry"/></mxCell><mxCell id="handle-v17" value="df/du gap&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;lsof +L1&lt;/font&gt; shows&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;nginx ... access.log (deleted)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="250" y="224" width="360" height="96" as="geometry"/></mxCell><mxCell id="handle-v18" value="someone ran rm on a live log, or&lt;br&gt;logrotate postrotate missing&lt;br&gt;or failing silently" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="630" y="224" width="320" height="96" as="geometry"/></mxCell><mxCell id="handle-v19" value="&lt;font face=&quot;Courier New&quot;&gt;nginx -s reopen&lt;/font&gt;  (USR1, no downtime)&lt;br&gt;other process:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;truncate -s 0 /proc/PID/fd/N&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="970" y="224" width="360" height="96" as="geometry"/></mxCell><mxCell id="handle-v20" value="keep stock postrotate, test with&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;logrotate -vf&lt;/font&gt;&lt;br&gt;alert on df/du gap; never rm live logs" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1350" y="224" width="400" height="96" as="geometry"/></mxCell><mxCell id="handle-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v16" target="handle-v17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v17" target="handle-v18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v18" target="handle-v19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v19" target="handle-v20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-v25" value="C. Proxy cache" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=20;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="190" height="96" as="geometry"/></mxCell><mxCell id="handle-v26" value="&lt;font face=&quot;Courier New&quot;&gt;nginx -T | grep proxy_cache_path&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;du -sh&lt;/font&gt; on the cache path" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="250" y="338" width="360" height="96" as="geometry"/></mxCell><mxCell id="handle-v27" value="no &lt;font face=&quot;Courier New&quot;&gt;max_size&lt;/font&gt;, or &lt;font face=&quot;Courier New&quot;&gt;max_size&lt;/font&gt;&lt;br&gt;close to disk size (flat 99% line)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="630" y="338" width="320" height="96" as="geometry"/></mxCell><mxCell id="handle-v28" value="delete files under the cache path&lt;br&gt;(expect more upstream load while it warms)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="970" y="338" width="360" height="96" as="geometry"/></mxCell><mxCell id="handle-v29" value="&lt;font face=&quot;Courier New&quot;&gt;max_size=20g min_free=10g&lt;/font&gt;&lt;br&gt;cache on its own EBS volume" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1350" y="338" width="400" height="96" as="geometry"/></mxCell><mxCell id="handle-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v25" target="handle-v26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v26" target="handle-v27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v27" target="handle-v28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handle-v28" target="handle-v29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="handle-v34" value="D. Proxy / request-body temp files" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=20;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="190" height="96" as="geometry"/></mxCell><mxCell id="handle-v35" value="spikes that follow traffic; df/du gap&lt;br&gt;that disappears off-peak; &lt;font face=&quot;Courier New&quot;&gt;lsof +L1&lt;/font&gt;&lt;br&gt;shows &lt;font face=&quot;Courier New&quot;&gt;/var/lib/nginx/proxy (deleted)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="250" y="452" width="360" height="96" as="geometry"/></mxCell><mxCell id="handle-v36" value="slow clients on large responses&lt;br&gt;(up to 1 GB each by default);&lt;br&gt;large uploads buffered to disk" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="630" y="452" width="320" height="96" as="geometry"/></mxCell><mxCell id="handle-v37" value="free space (stabilise step);&lt;br&gt;space returns as requests finish" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="970" y="452" width="360" height="96" as="geometry"/></mxCell><mxCell id="handle-v38" value="&lt;font face=&quot;Courier New&quot;&gt;proxy_max_temp_file_size 256m&lt;/font&gt; (or 0)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;client_max_body_size&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;proxy_request_buffering off&lt;/font&gt; on uploads" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;" vert