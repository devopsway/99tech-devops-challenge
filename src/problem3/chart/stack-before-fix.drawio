        <mxCell id="deps" value="&lt;b&gt;docker-compose.yml&lt;/b&gt;: depends_on nginx → api → postgres, redis (start order only)&lt;br&gt;no healthchecks, no restart policy, password hard-coded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="520" height="44" as="geometry" />
        </mxCell>

        <mxCell id="nginx" value="&lt;b&gt;nginx&lt;/b&gt; (nginx:1.25)&lt;br&gt;listen 80&lt;br&gt;location = / → 200 &quot;Welcome&quot;&lt;br&gt;location /api/ → proxy_pass api:3001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="190" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;api&lt;/b&gt; (build ./api, node:20-alpine)&lt;br&gt;express, listens on :3000&lt;br&gt;GET /api/users, GET /status&lt;br&gt;pg Pool + ioredis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="190" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="postgres" value="&lt;b&gt;postgres&lt;/b&gt; (postgres:15)&lt;br&gt;:5432, not published&lt;br&gt;max_connections = 100 (default)&lt;br&gt;no volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="110" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="&lt;b&gt;redis&lt;/b&gt; (redis:7)&lt;br&gt;:6379, not published&lt;br&gt;key: last_call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="300" width="210" height="80" as="geometry" />
        </mxCell>

        <mxCell id="confd" value="./nginx/conf.d → /etc/nginx/conf.d&lt;br&gt;(mounted: default.conf)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="360" width="210" height="46" as="geometry" />
        </mxCell>

        <mxCell id="nginxconf" value="./nginx/nginx.conf&lt;br&gt;empty file, not mounted" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#777777;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="440" width="210" height="46" as="geometry" />
        </mxCell>

        <mxCell id="initsql" value="./postgres/init.sql&lt;br&gt;ALTER SYSTEM SET max_connections = 20&lt;br&gt;not mounted, never runs" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#777777;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="430" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e-user-nginx" value="HTTP localhost:8080&lt;br&gt;(ports 8080:80)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="nginx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-nginx-api" value="proxy_pass http://api:3001&lt;br&gt;&lt;b&gt;nothing listens on :3001 → 502&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=cross;endFill=0;strokeWidth=2;strokeColor=#b85450;dashed=1;fontColor=#b85450;fontSize=11;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="nginx" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-api-pg" value="pg Pool (max 10)&lt;br&gt;no connection timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#f5f5f5;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="api" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-api-redis" value="ioredis SET last_call&lt;br&gt;(awaited in request)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#f5f5f5;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="api" target="redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-confd" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="confd" target="nginx">
