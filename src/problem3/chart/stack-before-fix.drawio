        <mxCell id="host" value="Docker host: docker compose, default bridge network (service names resolved by Docker DNS)" style="rounded=1;arcSize=2;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;html=1;" vertex="1" parent="1">
