<mxfile host="app.diagrams.net">
  <diagram id="workflows" name="Workflows">
    <mxGraphModel dx="800" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Problem 4: how the GitHub Actions files relate&lt;/b&gt;" style="text;html=1;fontSize=16;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="be" value="&lt;b&gt;backend.yml&lt;/b&gt;&lt;br&gt;CI: test, build, scan,&lt;br&gt;push image to ECR" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;" vertex="1" parent="1"><mxGeometry x="160" y="50" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="fe" value="&lt;b&gt;frontend.yml&lt;/b&gt;&lt;br&gt;CI: test, build,&lt;br&gt;upload bundle to S3" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="rel" value="&lt;b&gt;release-staging.yml&lt;/b&gt;&lt;br&gt;release bot commits the new&lt;br&gt;SHA to staging (no AWS)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;" vertex="1" parent="1"><mxGeometry x="280" y="170" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="env" value="&lt;b&gt;environments/&lt;/b&gt; (Git)&lt;br&gt;release.yaml, settings.yaml,&lt;br&gt;frontend-config.json per environment" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="250" y="290" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="dep" value="&lt;b&gt;deploy.yml&lt;/b&gt;&lt;br&gt;only workflow that changes AWS;&lt;br&gt;deploys what changed, needs approval" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="rec" value="&lt;b&gt;reconcile.yml&lt;/b&gt;&lt;br&gt;read-only: Git vs live, hourly;&lt;br&gt;drift to Slack, validates PRs" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="bd" value="&lt;b&gt;backend-deploy.yml&lt;/b&gt;&lt;br&gt;launch template version,&lt;br&gt;instance refresh, smoke test" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="fd" value="&lt;b&gt;frontend-deploy.yml&lt;/b&gt;&lt;br&gt;ordered S3 upload,&lt;br&gt;invalidation, smoke test" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;" vertex="1" parent="1"><mxGeometry x="240" y="550" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="pr" value="&lt;b&gt;Promotion PR&lt;/b&gt;&lt;br&gt;copies staging versions to&lt;br&gt;production; code owner review" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;dashed=1;" vertex="1" parent="1"><mxGeometry x="510" y="550" width="200" height="64" as="geometry"/></mxCell>
