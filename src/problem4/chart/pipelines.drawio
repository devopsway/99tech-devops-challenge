        <mxCell id="env" value="Per environment (one stack each for staging and production)" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontColor=#C25E00;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="310" y="400" width="1070" height="430" as="geometry"/></mxCell>
