<mxfile host="app.diagrams.net">
  <diagram id="pipelines" name="Pipelines">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Problem 4: GitOps CI/CD for the backend (EC2) and frontend (S3)&lt;/b&gt;" style="text;html=1;fontSize=16;fontColor=#232F3E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="gh" value="&lt;b&gt;GitHub&lt;/b&gt;: CI in backend.yml / frontend.yml; deploys in deploy.yml (approval); status and drift in reconcile.yml; desired state in environments/" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#24292F;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontColor=#24292F;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1560" height="230" as="geometry"/></mxCell>
        <mxCell id="dev" value="Developer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="50" y="101" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="s_pr" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;lint, test, audit&lt;br&gt;build, Trivy scan,&lt;br&gt;smoke test" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F7F8F8;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="130" y="85" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="s_main" value="&lt;b&gt;Merge to main&lt;/b&gt;&lt;br&gt;publish to ECR / S3&lt;br&gt;bot commits SHA&lt;br&gt;to staging" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F7F8F8;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="335" y="85" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="s_env" value="&lt;b&gt;environments/&lt;/b&gt; (Git)&lt;br&gt;release.yaml&lt;br&gt;settings.yaml&lt;br&gt;desired state" style="shape=note;size=14;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF8E1;strokeColor=#C25E00;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="540" y="85" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="s_deploy" value="&lt;b&gt;deploy.yml&lt;/b&gt;&lt;br&gt;deploys what changed&lt;br&gt;approval required&lt;br&gt;(staging and production)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;dashed=1;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="745" y="85" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="s_rec" value="&lt;b&gt;reconcile.yml&lt;/b&gt; (read-only)&lt;br&gt;Git vs live, hourly&lt;br&gt;drift: notify Slack&lt;br&gt;opens promotion PR" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F7F8F8;strokeColor=#545B64;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="950" y="85" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="s_promo" value="&lt;b&gt;Promotion PR&lt;/b&gt;&lt;br&gt;CODEOWNERS review&lt;br&gt;merge changes&lt;br&gt;production" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;dashed=1;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1155" y="85" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="s_rb" value="&lt;b&gt;Rollback&lt;/b&gt;&lt;br&gt;git revert the&lt;br&gt;release commit (PR)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;dashed=1;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1360" y="85" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="e_dev" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="dev" target="s_pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="s_pr" target="s_main"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="s_main" target="s_env"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="s_env" target="s_deploy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="after&lt;br&gt;run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="s_deploy" target="s_rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="staging&lt;br&gt;ahead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;" edge="1" parent="1" source="s_rec" target="s_promo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="merged PR changes production" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;dashed=1;" edge="1" parent="1" source="s_promo" target="s_env"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1255" y="180"/><mxPoint x="630" y="180"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;dashed=1;" edge="1" parent="1" source="s_rb" target="s_env"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="180"/><mxPoint x="630" y="180"/></Array></mxGeometry></mxCell>
        <mxCell id="gh_note" value="GitOps: Git is the source of truth for what runs where. Only deploy.yml changes AWS, and every deploy needs approval. Actions pinned to major versions, per-job permissions, AWS access through GitHub OIDC roles scoped per environment." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="130" y="205" width="1430" height="40" as="geometry"/></mxCell>
        <mxCell id="aws" value="AWS Cloud" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="1400" height="560" as="geometry"/></mxCell>
        <mxCell id="region" value="Region (ap-southeast-1)" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1360" height="500" as="geometry"/></mxCell>
        <mxCell id="shared" value="Shared (one per account)" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontColor=#545B64;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="230" height="420" as="geometry"/></mxCell>
        <mxCell id="ecr" value="Amazon ECR&lt;br&gt;backend releases&lt;br&gt;(immutable tags)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="85" y="460" width="60" height="60" as="geometry"/></mxCell>
