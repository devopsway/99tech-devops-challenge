" style="rounded=1;arcSize=40;html=1;fillColor=#1D8102;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1124" y="276" width="30" height="18" as="geometry"/></mxCell><mxCell id="secured-flow-22" value="M2" style="rounded=1;arcSize=40;html=1;fillColor=#0073BB;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="391" width="30" height="18" as="geometry"/></mxCell><mxCell id="secured-flow-24" value="&lt;b&gt;ns matching&lt;/b&gt;: not in the mesh. No inbound calls, so no proxy on the engine's path." style="text;html=1;fontSize=10;fontColor=#545B64;align=left;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="1552" y="296" width="260" height="30" as="geometry"/></mxCell><mxCell id="secured-flow-25" value="X1" style="rounded=1;arcSize=40;html=1;fillColor=#FFFFFF;strokeColor=#879196;dashed=1;fontColor=#545B64;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1820" y="276" width="30" height="18" as="geometry"/></mxCell><mxCell id="secured-flow-27" value="Data stores: outside the cluster and the mesh" style="text;html=1;fontSize=11;fontColor=#147EBA;align=left;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="352" y="624" width="300" height="18" as="geometry"/></mxCell><mxCell id="secured-flow-29" value="V1" style="rounded=1;arcSize=40;html=1;fillColor=#0073BB;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1446" y="642" width="30" height="18" as="geometry"/></mxCell><mxCell id="secured-flow-32" value="HTTPS, from&lt;br&gt;ALB subnets only" style="text;html=1;fontSize=9;fontColor=#0073BB;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#FFFFFF;spacing=0;" vertex="1" parent="1"><mxGeometry x="252" y="400" width="70" height="26" as="geometry"/></mxCell><mxCell id="se