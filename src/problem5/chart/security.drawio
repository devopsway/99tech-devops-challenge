kloads" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF2E9;strokeColor=#ED7100;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="630" y="110" width="380" height="60" as="geometry"/></mxCell><mxCell id="secured-platform-14" value="watches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1;fontColor=#545B64;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="git" target="argo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="505"/><mxPoint x="590" y="140"/></Array></mxGeometry></mxCell><mxCell id="adm" value="&lt;b&gt;Kubernetes API server: admission&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Pod Security Admission: &lt;b&gt;restricted&lt;/b&gt;&lt;br&gt;2. Kyverno validate / mutate / generate&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;our registry, digests, limits, no exec, default-deny&lt;br&gt;3. Kyverno verifyImages: signed by the release key" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF2E9;strokeColor=#1D8102;strokeWidth=2;fontSize=10;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="630" y="220" width="380" height="140" as="geometry"/></mxCell><mxCell id="secured-platform-18" value="apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1;fontColor=#545B64;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="argo" target="adm"><mxGeometry x="-0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="kyv" value="&lt;b&gt;Kyverno&lt;/b&gt;&lt;br&gt;3 admission replicas across 3 AZs&lt;br&gt;excludes kube-system, kyverno, istio-system" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF2E9;strokeColor=#1D8102;strokeWidth=2;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1080" y="240" width="410" height="70" as="geometry"/></mxCell><mxCell id="secured-platform-19" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#1D8102;strokeWidth=1;fontColor=#1D8102;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="adm" target="kyv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="secured-platform-20" value="read signatures (Kyverno's own Pod Identity role)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#1D8102;strokeWidth=1;fontColor=#1D8102;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="kyv" target="ecr"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="1285" y="200"/><mxPoint x="424" y="200"/></Array></mxGeometry></mxCell><mxCell id="apps" value="&lt;b&gt;App namespaces&lt;/b&gt; (one per service)&lt;br&gt;&lt;br&gt;order-api · account-api · ws-gateway · market-data · settlement&lt;br&gt;&amp;nbsp;&amp;nbsp;→ ambient mesh, mTLS STRICT, AuthorizationPolicy per service&lt;br&gt;matching&lt;br&gt;&amp;nbsp;&amp;nbsp;→ not in the mesh (X1)&lt;br&gt;&lt;br&gt;all: default-deny NetworkPolicy, strict mode, no internet,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;own Pod Identity role for MSK and Valkey" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDF2E9;strokeColor=#ED7100;fontSize=10;fontColor=#232F3E;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="630" y="420" width="380" height="190" as="geometry"/></mxCell><mxCell id="secured-platform-25" value="admitted pods" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;strokeColor=#545B64;strokeWidth=1;fontColor=#545B64;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="adm" target="apps"><mxGeome